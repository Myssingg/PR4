<Window x:Class="ПР4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ПР4"
        mc:Ignorable="d"
        Title="MainWindow" Height="480" Width="780">
    <TabControl>
        <TabItem Header="Оружие">
            <StackPanel Orientation="Horizontal">
                <StackPanel>
                    <ListBox Width="350" Height="250" x:Name="ListBoxWeapons" IsEnabled="False" Margin="0,25,0,0">
                        
                    </ListBox>
                </StackPanel>

                <Separator Margin="15,0,15,0"/>

                <StackPanel Orientation="Vertical" HorizontalAlignment="Right" Width="300">
                    <Label Content="Введите имя оружия" Margin="0,20,0,0"/>
                    <TextBox x:Name="TextBoxName"/>
                    <Label Content="Введите уровень оружия"/>
                    <TextBox x:Name="TextBoxLevel"/>
                    <Label Content="Введите урон оружия"/>
                    <TextBox x:Name="TextBoxDamage"/>
                    <Label Content="Выберите тип оружия"/>
                    <ComboBox x:Name="ComboBoxType">
                        <ComboBoxItem Content="Меч"/>
                        <ComboBoxItem Content="Клинки"/>
                        <ComboBoxItem Content="Щит"/>
                        <ComboBoxItem Content="Лук"/>
                    </ComboBox>
                    <Separator Margin=" 0,15,0,15" Height="5"/>
                    <Button Content="Создать оружие" Click="ButtonCreate_Click"/>
                    <Separator Visibility="Hidden" Margin=" 0,15,0,15" Height="5" x:Name="SeparatorUpgrade"/>
                    <ComboBox x:Name="ComboBoxWeapon1" Visibility="Hidden" Margin="0,10,0,10"/>
                    <Button Visibility="Hidden" Content="Улучшить оружие" Click="ButtonUpgrade_Click" x:Name="ButtonUpgrade"/>
                    <ComboBox x:Name="ComboBoxWeapon2" Visibility="Hidden" Margin="0,10,0,10"/>
                </StackPanel>

            </StackPanel>
        </TabItem>
        <TabItem Header="Персонаж" Height="20" VerticalAlignment="Top" x:Name="PersonageTab" IsEnabled="False"> 
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Width="350" Margin="5,0,15,0">
                    <Image x:Name="ImageP" MaxHeight="300" Height="300" MaxWidth="320" Width="320" Stretch="Uniform" Source="/Images/img2.jpg"  Margin="0,30,0,0"/>
                    <Label x:Name="ImagePLabel" FontStyle="Italic" FontWeight="Bold" FontSize="20px" HorizontalAlignment="Center"/>
                    <Label x:Name="PowerP" FontSize="20px" FontStyle="Italic" HorizontalAlignment="Center" Background="Transparent" Foreground="Cyan"/>
                </StackPanel>
                
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Width="350" >
                    <Label Content="Введите имя персонажа" Margin="0,20,0,0"/>
                    <TextBox x:Name="TextBoxNameP"/>
                    <Label Content="Уровень "/>
                    <TextBox x:Name="TextBoxLevelP"/>
                    <Label Content="Сила"/>
                    <TextBox x:Name="TextBoxStrenghtP"/>
                    <Label Content="Ловкость"/>
                    <TextBox x:Name="TextBoxAgilityP"/>
                    <Label Content="Интелект"/>
                    <TextBox x:Name="TextBoxIntellectP"/>
                    <Label Content="Выберите тип оружия"/>
                    <ComboBox x:Name="ComboBoxTypeP"/>
                    <Separator Margin=" 0,15,0,15" Height="5"/>
                    <Button Content="Добавить персонажа" Click="ButtonCreatePers_Click" x:Name="ButtonCreatePers"/>
                </StackPanel>
            </StackPanel>
        </TabItem>
    </TabControl>

</Window>
